{
  "name": "@cangxu/assistant-runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "start": "node src/worker.ts",
    "lint": "biome check src test",
    "smoke": "node --env-file=.env.local src/smoke.ts",
    "serve": "node src/server.ts",
    "server": "node --env-file=.env.local src/server.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-durable": "1.2.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "24.10.1",
    "typescript": "6.0.2"
  }
}
