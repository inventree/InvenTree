# Copy to .env.local (ignored, chmod 600). Django and Node share the two identity values.
ASSISTANT_DEPLOYMENT_ID=
ASSISTANT_RUNTIME_TOKEN=
ASSISTANT_RUNTIME_URL=http://127.0.0.1:8789
ASSISTANT_DJANGO_URL=http://127.0.0.1:8000
ASSISTANT_PORT=8789
ASSISTANT_STORAGE_DIR=.state
ASSISTANT_MAX_PARTNERS=32
ASSISTANT_MODEL_PROVIDER=openai-compatible
ASSISTANT_MODEL_BASE_URL=http://127.0.0.1:3000/v1
ASSISTANT_MODEL_API_KEY=
ASSISTANT_MODEL_ID=
# Set false for text-only deployments; images remain saved and previewable.
ASSISTANT_MODEL_SUPPORTS_IMAGES=false
ASSISTANT_MODEL_MAX_OUTPUT_TOKENS=2048
ASSISTANT_MAX_TOOL_CALLS_PER_INPUT=64
ASSISTANT_DAILY_BUDGET=unlimited
